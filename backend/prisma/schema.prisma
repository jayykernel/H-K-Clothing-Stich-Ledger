generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  MERCHANDISER
  OPERATOR
  VIEWER
}

enum OrderStatus {
  DRAFT
  ACTIVE
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  password      String
  name          String
  role          Role           @default(VIEWER)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]

  @@index([email])
  @@index([role])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}

model Style {
  id            String   @id @default(cuid())
  styleNumber   String   @unique
  styleName     String
  fabricType    String
  gsm           Int      // Grams per square meter
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  fabrics       Fabric[]

  @@index([styleNumber])
}

model Fabric {
  id            String   @id @default(cuid())
  styleId       String
  style         Style    @relation(fields: [styleId], references: [id], onDelete: Cascade)
  serialNumber  String   @unique
  color         String
  pricePerKg    Decimal  // Price per kilogram
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([serialNumber])
  @@index([styleId])
}

model Component {
  id            String   @id @default(cuid())
  name          String
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([name])
}

model CostingRecord {
  id               String   @id @default(cuid())
  orderId          String?
  styleDetails     Json
  fabricDetails    Json
  sizeQuantities   Json
  measurements     Json
  componentDetails Json
  calculations     Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  orders           Order[]

  @@index([orderId])
}

model Order {
  id              String               @id @default(cuid())
  orderNumber     String               @unique
  buyerName       String
  styleNumber     String
  styleName       String?
  status          OrderStatus          @default(DRAFT)
  isArchived      Boolean              @default(false)
  costingRecordId String?
  costingRecord   CostingRecord?       @relation(fields: [costingRecordId], references: [id], onDelete: SetNull)
  totalQuantity   Int                  @default(0)
  totalAmount     Decimal?             @default(0)
  notes           String?
  deliveryDate    DateTime?
  items           OrderItem[]
  statusHistory   OrderStatusHistory[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([orderNumber])
  @@index([buyerName])
  @@index([styleNumber])
  @@index([status])
  @@index([isArchived])
  @@index([costingRecordId])
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  size       String
  quantity   Int      @default(0)
  unitPrice  Decimal? @default(0)
  totalPrice Decimal? @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([orderId])
  @@index([size])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  notes     String?
  changedBy String?
  createdAt DateTime    @default(now())

  @@index([orderId])
}
